{% set v = '{{' %}{% set w = '}}' %}
---
{% if psp_from | default(false) %}
# Tasks for test major upgrade for PPG {{ major }} packages.
#
# FROM_VERSION also accepts psp-{{ prev }}.14 (scenario: PSP-{{ prev }} -> PPG-{{ major }}) — the FROM
# side just gets pg_tde installed on top of the identical ppg-{{ prev }} package set
# (psp-{{ prev }} ships the same postgresql{{ prev }} packages, from a different repo
# channel); the pg_upgrade/port-swap/restart mechanics below are unchanged
# either way since the TO side is always plain ppg-{{ major }}.
{% elif flavor == 'psp' %}
# Major upgrade test: PPG-{{ prev }} -> PSP-{{ major }}.
#
# Same PostgreSQL major-version bump ({{ prev }} -> {{ major }}) as pg-{{ major }}-major-upgrade, plus
# the one PSP delta: install pg_tde and fold it into shared_preload_libraries
# alongside pg_stat_monitor before the final restart. Package names are
# unchanged from ppg-{{ major }} — psp-{{ major }} ships the same postgresql{{ major }} packages, just
# from a different repo channel (to_repo_version below trims the minor for
# that repo since psp-{{ major }} has no per-minor variant, unlike ppg-{{ major }}.14).
{% else %}
# Tasks for test major upgrade for PPG {{ major }} packages
{% endif %}

- name: Configure repository
  include_tasks: ../../../tasks/install_percona_release.yml

- name: setup epel release
  yum:
    name: epel-release
    update_cache: yes
    state: present
  when: ansible_os_family == "RedHat"

- name: Setting facts so that they will be persisted in the fact cache
  ansible.builtin.set_fact:
{% if psp_from | default(false) %}
    pg_version_to_install: "{{ v }} lookup('env', 'FROM_VERSION') | regex_replace('^(?:ppg|psp)-', '') {{ w }}"
    upgrade_to_pg_version: "{{ v }} lookup('env', 'VERSION') | regex_replace('^(?:ppg|psp)-', '') {{ w }}"
    # psp only ships one repo per major version (psp-{{ prev }}), no psp-{{ prev }}.xx minor
    # repos exist, unlike ppg (ppg-{{ prev }}.14 etc.) — trim the minor for psp only.
    from_repo_version: "{{ v }} lookup('env', 'FROM_VERSION').split('.')[0] if lookup('env', 'FROM_VERSION').startswith('psp-') else lookup('env', 'FROM_VERSION') {{ w }}"
{% elif flavor == 'psp' %}
    pg_version_to_install: "{{ v }} lookup('env', 'FROM_VERSION') | regex_replace('^(?:ppg|psp)-', '') {{ w }}"
    upgrade_to_pg_version: "{{ v }} lookup('env', 'VERSION') | regex_replace('^(?:ppg|psp)-', '') {{ w }}"
    # psp only ships one repo per major version (psp-{{ major }}), no psp-{{ major }}.xx minor
    # repos exist, unlike ppg (ppg-{{ major }}.14 etc.) — trim the minor for psp only.
    to_repo_version: "{{ v }} lookup('env', 'VERSION').split('.')[0] if lookup('env', 'VERSION').startswith('psp-') else lookup('env', 'VERSION') {{ w }}"
{% else %}
    pg_version_to_install: "{{ v }} lookup('env', 'FROM_VERSION') | replace('ppg-','') {{ w }}"
    upgrade_to_pg_version: "{{ v }} lookup('env', 'VERSION') | replace('ppg-','') {{ w }}"
{% endif %}

{{ gates_text }}

{% if psp_from | default(false) %}
- name: Setup initial (old) repository
  command: percona-release enable {{ v }} from_repo_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'FROM_REPO') {{ w }}"
{% else %}
- name: Setup initial (old) repository
  command: percona-release enable {{ v }} pg_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'FROM_REPO') {{ w }}"
    pg_version: "{{ v }} lookup('env', 'FROM_VERSION') {{ w }}"
{% endif %}

- name: install Percona Platform for PostgreSQL {{ prev }} packages
  include_tasks: ../../../../tasks/install_ppg{{ prev }}.yml

{% if major >= 18 %}
- name: Initialize Percona PostgreSQL {{ prev }} on RHEL
  ansible.builtin.command:
    cmd: "/usr/pgsql-{{ prev }}/bin/postgresql-{{ prev }}-setup initdb"
  become: true
  when: ansible_os_family == "RedHat"

- name: Enable checksums on Percona PostgreSQL {{ prev }} cluster
  ansible.builtin.command:
    cmd: "/usr/pgsql-{{ prev }}/bin/pg_checksums --enable -D /var/lib/pgsql/{{ prev }}/data"
  become: true
  when: ansible_os_family == "RedHat"
{% else %}
- name: Initialize Postgres RHEL
  command: /usr/pgsql-{{ prev }}/bin/postgresql-{{ prev }}-setup initdb
  environment:
    PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  when: ansible_os_family == "RedHat"
{% endif %}

- name: Install PPG tools
  include_tasks: ../../../../tasks/install_ppg{{ prev }}_tools.yml

{% if psp_from | default(false) %}
- name: Install pg_tde packages RHEL (PSP-{{ prev }} FROM version only)
  yum:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg_tde{{ prev }}
      - percona-pg_tde{{ prev }}-devel
      - percona-pg_tde{{ prev }}-debugsource
      - percona-pg_tde{{ prev }}-debuginfo
  when:
    - ansible_os_family == "RedHat"
    - lookup('env', 'FROM_VERSION').startswith('psp-')

- name: Install pg_tde packages Debian (PSP-{{ prev }} FROM version only)
  apt:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg-tde{{ prev }}
      - percona-pg-tde{{ prev }}-client
      - percona-pg-tde{{ prev }}-dbgsym
  when:
    - ansible_os_family == "Debian"
    - lookup('env', 'FROM_VERSION').startswith('psp-')

{% endif %}
- name: Start Postgres RHEL
  include_tasks: ../../../../tasks/start_postgres_with_diagnostics.yml
  vars:
    svc_name: postgresql-{{ prev }}
    svc_state: started
  when: ansible_os_family == "RedHat"

- name: Start postgresql service for Debian based
  include_tasks: ../../../../tasks/start_postgres_with_diagnostics.yml
  vars:
    svc_name: postgresql
    svc_state: started
  when: ansible_os_family == "Debian"

- name: Seed data-integrity baseline before upgrade
  include_tasks: ../../../../tasks/seed_data_integrity.yml

{% if psp_from | default(false) %}
- name: Disable old repository
  command: percona-release disable {{ v }} from_repo_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'FROM_REPO') {{ w }}"
{% else %}
- name: Disable old repository
  command: percona-release disable {{ v }} pg_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'FROM_REPO') {{ w }}"
    pg_version: "{{ v }} lookup('env', 'FROM_VERSION') {{ w }}"
{% endif %}

{% if flavor == 'psp' %}
- name: Setup new repository
  command: percona-release enable-only {{ v }} to_repo_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'TO_REPO') {{ w }}"
{% else %}
- name: Setup new repository
  command: percona-release {{ 'enable-only' if enable_only | default(true) else 'enable' }} {{ v }} pg_version {{ w }} {{ v }} repo {{ w }}
  vars:
    repo: "{{ v }} lookup('env', 'TO_REPO') {{ w }}"
    pg_version: "{{ v }} lookup('env', 'VERSION') {{ w }}"
{% endif %}

- name: install Percona Platform for PostgreSQL deb packages
  apt:
    name: "{{ v }} packages {{ w }}"
    update_cache: yes
    state: latest
  vars:
    packages:
      - percona-postgresql
      - percona-postgresql-{{ major }}
      - percona-postgresql-all
      - percona-postgresql-client
      - percona-postgresql-client-{{ major }}
      - percona-postgresql-common
      - percona-postgresql-contrib
      - percona-postgresql-doc
      - percona-postgresql-doc-{{ major }}
      - percona-postgresql-plperl-{{ major }}
      - percona-postgresql-plpython3-{{ major }}
      - percona-postgresql-pltcl-{{ major }}
      - percona-postgresql-server-dev-{{ major }}
      - {{ dev_pkg_deb | default('percona-postgresql-common-dev') }}
      - percona-postgresql-{{ major }}-dbgsym
      - percona-postgresql-client-{{ major }}-dbgsym
      - percona-postgresql-plperl-{{ major }}-dbgsym
      - percona-postgresql-plpython3-{{ major }}-dbgsym
      - percona-postgresql-pltcl-{{ major }}-dbgsym
      - postgresql-client-common
      - postgresql-common
  when: ansible_os_family == "Debian"
  environment:
      PERCONA_TELEMETRY_URL: "https://check-dev.percona.com/v1/telemetry/GenericReport"

{% if commented_plpython | default(false) %}
# - name: install Percona Platform for PostgreSQL deb packages
#   apt:
#     name: "{{ v }} packages {{ w }}"
#     update_cache: yes
#     state: latest
#   vars:
#     packages:
#     - percona-postgresql-plpython3-{{ major }}
#     - percona-postgresql-plpython3-{{ major }}-dbgsym
#   when:
#     - ansible_os_family == "Debian"

{% endif %}
{% if commented_llvm | default(false) %}
# - name: Disable llvm-toolset dnf module for RHEL8
#   become: true
#   command: dnf module disable llvm-toolset -y
#   when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

{% endif %}
#Remove conflicting package to make installation move on
- name: Remove conflicting percona-postgresql-common-dev
  ansible.builtin.package:
    name: percona-postgresql-common-dev
    state: absent
  when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('{{ remove_conflicting_dev }}', '>=', strict=True))

- name: install Percona Platform for PostgreSQL rpm packages for RHEL
  yum:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
        - percona-postgresql-client-common
        - percona-postgresql-common
{% if major >= 18 %}
        - percona-postgresql-common-dev
{% endif %}
        - percona-postgresql{{ major }}
        - percona-postgresql{{ major }}-contrib
        - percona-postgresql{{ major }}-debuginfo
        - percona-postgresql{{ major }}-devel
        - percona-postgresql{{ major }}-docs
        - percona-postgresql{{ major }}-libs
        - percona-postgresql{{ major }}-llvmjit
        - percona-postgresql{{ major }}-plpython3
        - percona-postgresql{{ major }}-plperl
        - percona-postgresql{{ major }}-pltcl
        - percona-postgresql{{ major }}-server
        - percona-postgresql{{ major }}-test
        - percona-postgresql{{ major }}-contrib-debuginfo
        - percona-postgresql{{ major }}-debuginfo
        - percona-postgresql{{ major }}-debugsource
        - percona-postgresql{{ major }}-devel-debuginfo
        - percona-postgresql{{ major }}-libs-debuginfo
        - percona-postgresql{{ major }}-plperl-debuginfo
        - percona-postgresql{{ major }}-pltcl-debuginfo
        - percona-postgresql{{ major }}-plpython3-debuginfo
        - percona-postgresql{{ major }}-server-debuginfo
  when: ansible_os_family == "RedHat"
  environment:
      PERCONA_TELEMETRY_URL: "https://check-dev.percona.com/v1/telemetry/GenericReport"

{% if dev_switch_active | default(true) %}
- name: Determine required PostgreSQL dev package for RHEL
  set_fact:
    pg_dev_package: >-
      {{ v }} 'percona-postgresql-server-dev-all'
         if (upgrade_to_pg_version | string is version('{{ dev_switch_cutoff }}', '<=', strict=True))
         else 'percona-postgresql-common-dev' {{ w }}
  when: ansible_os_family == "RedHat"

- name: Install PostgreSQL dev package on RHEL
  yum:
    name: "{{ v }} pg_dev_package {{ w }}"
    state: latest
    update_cache: yes
  when: ansible_os_family == "RedHat"

{% endif %}
{% if major >= 18 %}
- name: Install pg_tde packages RHEL
  yum:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
    - percona-pg_tde{{ major }}
    - percona-pg_tde{{ major }}-devel
    - percona-pg_tde{{ major }}-debugsource
    - percona-pg_tde{{ major }}-debuginfo
  when: ansible_os_family == "RedHat"

- name: Install pg_tde packages Debian
  apt:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
    - percona-pg-tde{{ major }}
    - percona-pg-tde{{ major }}-client
    - percona-pg-tde{{ major }}-dbgsym
  when: ansible_os_family == "Debian"

{% endif %}
- name: Install pg-stat-monitor RHEL
  yum:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg_stat_monitor{{ major }}
  when: ansible_os_family == "RedHat"

- name: Install pg-stat-monitor debian
  apt:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg-stat-monitor{{ major }}
  when: ansible_os_family == "Debian"

{% if flavor == 'psp' %}
- name: Install pg_tde packages RHEL
  yum:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg_tde{{ major }}
      - percona-pg_tde{{ major }}-devel
      - percona-pg_tde{{ major }}-debugsource
      - percona-pg_tde{{ major }}-debuginfo
  when: ansible_os_family == "RedHat"

- name: Install pg_tde packages Debian
  apt:
    name: "{{ v }} packages {{ w }}"
    state: latest
    update_cache: yes
  vars:
    packages:
      - percona-pg-tde{{ major }}
      - percona-pg-tde{{ major }}-client
      - percona-pg-tde{{ major }}-dbgsym
  when: ansible_os_family == "Debian"

{% endif %}
{% if major >= 18 %}
- name: Initialize Percona PostgreSQL {{ major }} on RHEL
  ansible.builtin.command:
    cmd: "/usr/pgsql-{{ major }}/bin/postgresql-{{ major }}-setup initdb"
  become: true
  when: ansible_os_family == "RedHat"

- name: Set io_method to worker for PG {{ major }}
  ansible.builtin.lineinfile:
    path: "/var/lib/pgsql/{{ major }}/data/postgresql.conf"
    regexp: '^io_method'
    line: "io_method = 'worker'"
  become: true
  when: ansible_os_family == "RedHat"
{% else %}
- name: Initialize Postgres RHEL
  command: /usr/pgsql-{{ major }}/bin/postgresql-{{ major }}-setup initdb
  environment:
    PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  when: ansible_os_family == "RedHat"
{% endif %}

- name: Stop postgresql service for RHEL based
  service:
    name: postgresql-{{ prev }}
    state: stopped
  when: ansible_os_family == "RedHat"

- name: Stop postgresql service for Debian based
  service:
    name: postgresql
    state: stopped
  when: ansible_os_family == "Debian"

{% if major >= 18 %}
- name: Create PostgreSQL {{ major }} cluster on Debian with no checksums
  ansible.builtin.command: >
    /usr/bin/pg_createcluster {{ major }} main --port=5433 -- --no-data-checksums
  become: true
  become_user: postgres
  when: ansible_os_family == "Debian"

- name: Set io_method = 'worker' for PostgreSQL {{ major }} cluster
  lineinfile:
    path: /etc/postgresql/{{ major }}/main/postgresql.conf
    line: "io_method = 'worker'"
  when: ansible_os_family == "Debian"

- pause:
    minutes: 1

- name: Add Percona PG{{ major }} lib to ld.so.conf.d
  become: true
  ansible.builtin.copy:
    dest: /etc/ld.so.conf.d/percona-pg{{ major }}.conf
    content: "/usr/lib/postgresql/{{ major }}/lib"
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family == "Debian"

- name: Add Percona PG{{ major }} lib to ld.so.conf.d
  become: true
  ansible.builtin.copy:
    dest: /etc/ld.so.conf.d/percona-pg{{ major }}.conf
    content: "/usr/pgsql-{{ major }}/lib"
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family == "RedHat"

- name: Run ldconfig after adding percona lib path
  become: true
  ansible.builtin.command: /sbin/ldconfig
{% else %}
- name: Execute pg_createcluster for version {{ major }}
  command: /usr/bin/pg_createcluster {{ major }} main --port=5433
  become: true
  become_method: sudo
  become_user: postgres
  when: ansible_os_family == "Debian"

- pause:
    minutes: 1
{% endif %}

- name: Execute pg_upgrade RHEL
  command: /usr/pgsql-{{ major }}/bin/pg_upgrade --old-bindir /usr/pgsql-{{ prev }}/bin --new-bindir /usr/pgsql-{{ major }}/bin --old-datadir /var/lib/pgsql/{{ prev }}/data --new-datadir /var/lib/pgsql/{{ major }}/data
  become: true
  become_user: postgres
  args:
    chdir: /tmp
  when: ansible_os_family == "RedHat"

- name: Execute pg_upgrade Deb
  command: /usr/lib/postgresql/{{ major }}/bin/pg_upgrade --old-datadir=/var/lib/postgresql/{{ prev }}/main --new-datadir=/var/lib/postgresql/{{ major }}/main --old-bindir=/usr/lib/postgresql/{{ prev }}/bin --new-bindir=/usr/lib/postgresql/{{ major }}/bin --old-options '-c config_file=/etc/postgresql/{{ prev }}/main/postgresql.conf' --new-options '-c config_file=/etc/postgresql/{{ major }}/main/postgresql.conf'
  become: true
  become_method: sudo
  become_user: postgres
  args:
    chdir: /tmp
  when: ansible_os_family == "Debian"

- name: Change postgresql {{ prev }} port in config Debian
  lineinfile:
    path: /etc/postgresql/{{ prev }}/main/postgresql.conf
    search_string: 'port'
    line: port = 5433
  when: ansible_os_family == "Debian"

- name: Change postgresql {{ prev }} port in config RHEL
  lineinfile:
    path: /var/lib/pgsql/{{ prev }}/data/postgresql.conf
    search_string: 'port'
    line: port = 5433
  when: ansible_os_family == "RedHat"

- name: Change postgresql {{ major }} port in config Debian
  lineinfile:
    path: /etc/postgresql/{{ major }}/main/postgresql.conf
    search_string: 'port'
    line: port = 5432
  when: ansible_os_family == "Debian"

- name: Change postgresql {{ major }} port in config RHEL
  lineinfile:
    path: /var/lib/pgsql/{{ major }}/data/postgresql.conf
    search_string: 'port'
    line: port = 5432
  when: ansible_os_family == "RedHat"

{% if flavor == 'psp' %}
- name: Add extensions to postgresql.conf for Debian
  lineinfile:
    path: /etc/postgresql/{{ major }}/main/postgresql.conf
    regexp: '^#?shared_preload_libraries\s*='
    line: shared_preload_libraries = 'pg_stat_monitor, pg_tde'
  when: ansible_os_family == "Debian"

- name: Add extensions to postgresql.conf for RHEL
  lineinfile:
    path: /var/lib/pgsql/{{ major }}/data/postgresql.conf
    regexp: '^#?shared_preload_libraries\s*='
    line: shared_preload_libraries = 'pg_stat_monitor, pg_tde'
  when: ansible_os_family == "RedHat"
{% else %}
- name: Add extensions to postgresql.conf for Debian
  lineinfile:
    path: /etc/postgresql/{{ major }}/main/postgresql.conf
    line: shared_preload_libraries = 'pg_stat_monitor'
  when: ansible_os_family == "Debian"

- name: Add extensions to postgresql.conf for RHEL
  lineinfile:
    path: /var/lib/pgsql/{{ major }}/data/postgresql.conf
    line: shared_preload_libraries = 'pg_stat_monitor'
  when: ansible_os_family == "RedHat"
{% endif %}

- name: Restart postgresql service for RHEL based
  include_tasks: ../../../../tasks/start_postgres_with_diagnostics.yml
  vars:
    svc_name: postgresql-{{ major }}
    svc_state: restarted
  when: ansible_os_family == "RedHat"

{% if legacy_tail | default(false) %}
- name: list /var/run/postgresql
  command: ls -la /var/run/postgresql
  become: true
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

- name: list pg_lsclsuters
  command: pg_lsclusters
  become: true
  become_method: sudo
  become_user: postgres
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

{% endif %}
- name: Drop pg_dropcluster for version {{ prev }}
  command: /usr/bin/pg_dropcluster {{ prev }} main
  become: true
  become_method: sudo
  become_user: postgres
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

- name: list pg_lsclsuters
  command: pg_lsclusters
  become: true
  become_method: sudo
  become_user: postgres
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

- name: Delete /var/run/postgresql lock and pid file
  command: rm -fr /var/run/postgresql/*
  become: true
  when: ansible_os_family == "Debian"
  register: results

{% if legacy_tail | default(false) %}
- debug:
    var: results.stdout_lines

- name: list /var/run/postgresql
  command: ls -la /var/run/postgresql/
  become: true
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

- name: Restart postgresql service for Debian based
  include_tasks: ../../../../tasks/start_postgres_with_diagnostics.yml
  vars:
    svc_name: postgresql@{{ major }}-main.service
    svc_state: started
  when: ansible_os_family == "Debian"

- name: list pg_lsclsuters
  command: pg_lsclusters
  become: true
  become_method: sudo
  become_user: postgres
  when: ansible_os_family == "Debian"
  register: results

- debug:
    var: results.stdout_lines

# - name: show running process for postgres
#   command: ps -ef | grep -i postgres
#   become: true
#   when: ansible_os_family == "Debian"
#   register: results

# - debug:
#     var: results.stdout_lines

- pause:
    minutes: 1

- name: Display ppg version
  ignore_errors: true
  become_user: postgres
  shell: psql -c "select version();"
  register: results

- debug:
    var: results.stdout_lines
{% else %}
- name: Restart postgresql service for Debian based
  include_tasks: ../../../../tasks/start_postgres_with_diagnostics.yml
  vars:
    svc_name: postgresql@{{ major }}-main.service
    svc_state: restarted
  when: ansible_os_family == "Debian"

- name: Display ppg version
  become_user: postgres
  shell: psql -c "select version()"
  register: results

- debug: var=results.stdout_lines
{% endif %}
{% if telemetry_upgrade_verify | default(true) %}

# =========Telemetry weak-dependency upgrade verification
- name: Verify telemetry weak-dependency survived the upgrade
  include_tasks: ../../../tasks/verify_telemetry_upgrade.yml
{% endif %}
