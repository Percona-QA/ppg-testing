{% import '_shared.j2' as s %}
os_list: all
name_pattern: '{token}-{build}-{job}'
aws:
  size: large
  subnet: aws1
cleanup: none
verifier:
  testinfra:
    directory: ../../../tests/tests_{{ 'psp' if flavor == 'psp' else 'ppg' }}
    markers:
    - upgrade
sequences:
  destroy:
  - destroy
  test:
  - destroy
  - create
  - prepare
  - converge
  - verify
  - destroy
{{ s.os_overrides() -}}
