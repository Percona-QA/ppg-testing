---
- name: Cleanup
  hosts: all
  become: true
  become_method: sudo
  tasks:
    - name: remove Postgresql rpm packages
      yum:
        name: "{{ '{{' }} packages {{ '}}' }}"
        state: absent
      vars:
        packages:
          - percona-postgresql-client-common
          - percona-postgresql-common
          - percona-postgresql{{ major }}
          - percona-wal2json{{ major }}
          - percona-pg-stat-monitor{{ major }}
          - percona-pgaudit
          - percona-pg_repack{{ major }}
      when: ansible_os_family == "RedHat"
