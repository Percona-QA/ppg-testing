{% import '_shared.j2' as s %}
os_list: all
name_pattern: '{token}-{build}-{job}'
aws:
  size: large
  subnet: {{ subnet }}
cleanup: per-family
verifier:
  testinfra:
    directory: ../../../tests/tests_{{ 'psp' if flavor == 'psp' else 'ppg' }}
sequences:
  destroy:
  - destroy
  test:
  - destroy
  - create
  - prepare
  - converge
  - verify
  - cleanup
  - destroy
  cleanup:
  - cleanup
{{ s.server_params(flavor, major, default_version) }}
{{ s.os_overrides() -}}
