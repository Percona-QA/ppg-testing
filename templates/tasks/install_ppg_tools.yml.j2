---
  - name: Setting facts so that they will be persisted in the fact cache
    ansible.builtin.set_fact:
      pgaudit_rhel_package_name: "percona-pgaudit"
      postgis_rhel_package_name_prefix: "percona-postgis35"

  - name: Setting facts so that they will be persisted in the fact cache
    ansible.builtin.set_fact:
      pgaudit_rhel_package_name: "percona-pgaudit<< major >>"
      postgis_rhel_package_name_prefix: "percona-postgis35_<< major >>"
    when: (pg_version_to_install | string is version('<< vars_gate >>', '>=', strict=True))

  - debug:
      msg: "Value of pgaudit_rhel_package_name is : {{ pgaudit_rhel_package_name }}"

  - debug:
      msg: "Value of postgis_rhel_package_name_prefix is : {{ postgis_rhel_package_name_prefix }}"

  - name: Install additional tools for pgbackrest test Debian
    apt:
      name: "{{ packages }}"
      state: latest
    vars:
      packages:
        - libxml-checker-perl
        - libyaml-perl
        - texlive-latex-base
        - texlive-latex-extra
        - texlive-fonts-recommended
        - lcov
        - rsync
        - zlib1g-dev
        - libssl-dev
        - libxml2-dev
        - libpq-dev
        - pkg-config
        - valgrind
        - liblz4-dev
        - zstd
        - libzstd-dev
        - bzip2
        - libbz2-dev
        - libipc-run-perl
        - libtext-csv-xs-perl
        - python3-systemd
    when: ansible_os_family == "Debian"

  - name: Ensure correct lz4 package is installed (Debian/Ubuntu)
    ansible.builtin.apt:
      name: "{{ lz4_package }}"
      state: present
      update_cache: yes
    vars:
      lz4_package: >-
        {% if ansible_distribution == 'Debian' and (ansible_distribution_major_version | int) < 13 %}
          liblz4-tool
        {% elif ansible_distribution == 'Ubuntu' and (ansible_distribution_major_version | int) <= 24 %}
          liblz4-tool
        {% else %}
          lz4
        {% endif %}
    when: ansible_os_family == "Debian"

  - name: Install pgaudit Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-postgresql-<< major >>-pgaudit
        - percona-postgresql-<< major >>-pgaudit-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install pgaudit RHEL
    yum:
      name: "{{ pgaudit_rhel_package_name }}"
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install pgbackrest Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgbackrest
        - percona-pgbackrest-doc
        - percona-pgbackrest-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install pgbackrest RHEL
    yum:
      name: percona-pgbackrest
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Create pgbackrest directory
    file:
      path: /etc/pgbackrest/
      state: directory

  - name: Create pgbackrest configuration Debian
    blockinfile:
      path: /etc/pgbackrest/pgbackrest.conf
      create: yes
      block: |
        [global]
        repo1-path=/var/lib/pgbackrest

        [testing]
        pg1-path=/var/lib/postgresql/<< major >>/main
        pg1-port=5432
    when: ansible_os_family == "Debian"

  - name: Create pgbackrest configuration RHEL
    blockinfile:
      path: /etc/pgbackrest/pgbackrest.conf
      create: yes
      block: |
        [global]
        repo1-path=/var/lib/pgbackrest

        [testing]
        pg1-path=/var/lib/pgsql/<< major >>/data
        pg1-port=5432
    when: ansible_os_family == "RedHat"

  - name: Configure backup config for Debian
    blockinfile:
      path: /etc/postgresql/<< major >>/main/postgresql.conf
      block: |
        archive_mode = on
        archive_command = 'pgbackrest --stanza=testing archive-push %p'
        max_wal_senders = 10
        wal_level = logical
    when: ansible_os_family == "Debian"

  - name: Configure backup config for RHEL
    blockinfile:
      path: /var/lib/pgsql/<< major >>/data/postgresql.conf
      block: |
        archive_mode = on
        archive_command = 'pgbackrest --stanza=testing archive-push %p'
        max_wal_senders = 10
        wal_level = logical
    when: ansible_os_family == "RedHat"

  - name: Restart Postgres RHEL
    include_tasks: "{{ role_path }}/../../tasks/start_postgres_with_diagnostics.yml"
    vars:
      svc_name: postgresql-<< major >>
      svc_state: restarted
    when: ansible_os_family == "RedHat"

  - name: Restart Postgres Debian
    include_tasks: "{{ role_path }}/../../tasks/start_postgres_with_diagnostics.yml"
    vars:
      svc_name: postgresql
      svc_state: restarted
    when: ansible_os_family == "Debian"

  - name: Install pgrepack Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-postgresql-<< major >>-repack
        - percona-postgresql-<< major >>-repack-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install pgrepack RHEL
    yum:
      name: percona-pg_repack<< major >>
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  # --- Patroni/etcd/haproxy HA sandbox -------------------------------------
  # This role also runs a plain, standalone PostgreSQL instance (initdb'd
  # and started earlier in this role's tasks/main.yml) that dozens of
  # unrelated tests in this same file exercise directly (pgbackrest,
  # pgaudit, pg_stat_monitor, postgis, pg_cron, telemetry, etc.). The
  # Patroni cluster below is a fully separate, isolated 3-node sandbox --
  # its own data dirs/ports under patroni_test/, nodes named
  # postgresql0/1/2 -- so it never touches that standalone instance.
  # Because of that isolation, the plain `patroni` systemd unit (installed
  # by the package) is only ever a packaging-sanity check here
  # (test_patroni_service asserts is_enabled, nothing about it actually
  # running or being part of the cluster); the *real* cluster members are
  # patroni0/patroni1/patroni2. See the Debian "Enable (but do not start)
  # patroni" task below for why that distinction matters in practice.
  #
  # The patroniN service/config files themselves live in the shared
  # files/patroni_common/ at the repo root, not in this role's own files/ --
  # they're identical (or, for the postgresqlN configs, differ only by the
  # bin_dir path) across every ppg-<major> role, so ppg-14..18 all render
  # them from that one shared location instead of keeping five near-
  # duplicate copies.
  - name: Set patroni template major version fact
    set_fact:
      patroni_pg_major: "{{ pg_version_to_install.split('.')[0] }}"

  - name: Install patroni RPM
    yum:
      name: percona-patroni
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install python3-pip
    yum:
      name: python3-pip
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "9"

  - name: Install patroni debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-patroni
        - percona-patroni-doc
    when: ansible_os_family == "Debian"

  - name: Install pg-stat-monitor RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pg_stat_monitor<< major >>
        - percona-pg_stat_monitor<< major >>-debuginfo
    when: ansible_os_family == "RedHat"

  - name: Install pg-stat-monitor debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pg-stat-monitor<< major >>
        - percona-pg-stat-monitor<< major >>-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install pgbadger RHEL
    yum:
      name: percona-pgbadger
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install pgbadger Debian
    apt:
      name: percona-pgbadger
      state: latest
      update_cache: yes
    when: ansible_os_family == "Debian"

  - name: Install CPAN
    become: true
    command: yum -y install perl-CPAN
    environment:
      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "9"

  - name: Install perl-App-cpanminus
    become: true
    command: yum -y install perl-App-cpanminus
    environment:
      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "9"

  - name: Install perl module Benchmark
    become: true
    command: cpanm Benchmark
    environment:
      PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "9"

  - name: Install percona-pgaudit<< major >>_set_user RHEL
    yum:
      name: percona-pgaudit<< major >>_set_user
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install percona-pgaudit<< major >>_set_user Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgaudit<< major >>-set-user
        - percona-pgaudit<< major >>-set-user-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install percona-pgbouncer RHEL
    yum:
      name: percona-pgbouncer
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install percona-pgbouncer Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgbouncer
        - percona-pgbouncer-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install percona-pgpool RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgpool-II-pg<< major >>
        - percona-pgpool-II-pg<< major >>-extensions
<% if pgpool_low_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< pgpool_low_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Install percona-pgpool Debian (libpgpool2 for < << pgpool_switch >>)
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgpool2
        - libpgpool2
    when: >
      ansible_os_family == "Debian" and
<% if pgpool_low_gate is defined %>
      pg_version_to_install | string is version('<< pgpool_low_gate >>', '>=', strict=True) and
<% endif %>
      pg_version_to_install | string is version('<< pgpool_switch >>', '<', strict=True)

  - name: Install percona-pgpool Debian (libpgpoolpcp3 for >= << pgpool_switch >>)
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pgpool2
        - libpgpoolpcp3
    when: >
      ansible_os_family == "Debian" and
      pg_version_to_install | string is version('<< pgpool_switch >>', '>=', strict=True)

  - name: Enable llvm-toolset for RHEL8 to install PostGIS
    become: true
    command: dnf module enable llvm-toolset -y
    when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

  - name: Install percona-postgis RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - "{{postgis_rhel_package_name_prefix}}"
      - "{{postgis_rhel_package_name_prefix}}-client"
      - "{{postgis_rhel_package_name_prefix}}-client-debuginfo"
      - "{{postgis_rhel_package_name_prefix}}-debuginfo"
      - "{{postgis_rhel_package_name_prefix}}-devel"
      - "{{postgis_rhel_package_name_prefix}}-docs"
      - "{{postgis_rhel_package_name_prefix}}-gui"
      - "{{postgis_rhel_package_name_prefix}}-gui-debuginfo"
      - "{{postgis_rhel_package_name_prefix}}-llvmjit"
      - "{{postgis_rhel_package_name_prefix}}-utils"
<% if postgis_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< postgis_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Install percona-postgis Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-postgresql-<< major >>-postgis-3
        - percona-postgresql-<< major >>-postgis-3-scripts
        - percona-postgresql-postgis-scripts
        - percona-postgresql-postgis
        - percona-postgis
<% if postgis_gate is defined %>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< postgis_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "Debian"
<% endif %>

  - name: Install percona-wal2json<< major >> RHEL
    yum:
      name: percona-wal2json<< major >>
      state: latest
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install percona-wal2json<< major >> Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-postgresql-<< major >>-wal2json
        - percona-postgresql-<< major >>-wal2json-dbgsym
    when: ansible_os_family == "Debian"

  - name: Install percona-pg_gather RHEL
    yum:
      name: percona-pg_gather
      state: latest
      update_cache: yes
<% if gather_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< gather_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Install percona-pg_gather Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - percona-pg-gather
<% if gather_gate is defined %>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< gather_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "Debian"
<% endif %>

<% if not legacy_layout | default(false) %>
  - name: Install pgvector packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pgvector_<< major >>
      - percona-pgvector_<< major >>-debuginfo
      - percona-pgvector_<< major >>-debugsource
      - percona-pgvector_<< major >>-llvmjit
<% if pgvector_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< pgvector_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Install pgvector packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-postgresql-<< major >>-pgvector
<% if pgvector_gate is defined %>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< pgvector_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "Debian"
<% endif %>

  - name: Install pg_tde packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pg_tde<< major >>
      - percona-pg_tde<< major >>-devel
      - percona-pg_tde<< major >>-debugsource
      - percona-pg_tde<< major >>-debuginfo
<% if tde_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< tde_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Install pg_tde packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pg-tde<< major >>
      - percona-pg-tde<< major >>-client
      - percona-pg-tde<< major >>-dbgsym
<% if tde_gate is defined %>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< tde_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "Debian"
<% endif %>

<% if oidc | default(false) %>
  - name: Install pg_oidc_validator packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pg_oidc_validator<< major >>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< major >>.2', '>=', strict=True))

  - name: Install pg_oidc_validator packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pg-oidc-validator<< major >>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< major >>.2', '>=', strict=True))

<% endif %>
<% endif %>  - name: Install pg_cron packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pg_cron_<< major >>
    when:
      - ansible_os_family == "RedHat"
      - pg_version_to_install | string is version('<< cron_gate >>', '>', strict=True)

  - name: Install pg_cron packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-postgresql-<< major >>-cron
    when:
      - ansible_os_family == "Debian"
      - pg_version_to_install | string is version('<< cron_gate >>', '>', strict=True)

  - name: Configure shared_preload_libraries
    vars:
<% if oidc | default(false) %>
      # 1. Define base extensions
      # pg_oidc_validator is NOT preloaded; it is tested as a regular extension via CREATE EXTENSION
      base_extensions: << base_extensions >>

      # 2. Conditionally add pg_cron (available from << major >>.4 onwards)
      final_extensions: >-
        {{
          base_extensions
          + (['pg_cron'] if (
              pg_version_to_install | string is version('<< cron_gate >>', '>', strict=True)
            ) else [])
        }}

      # 3. Handle OS-specific paths dynamically
      pg_conf_path: "{{ '/etc/postgresql/<< major >>/main/postgresql.conf' if ansible_os_family == 'Debian' else '/var/lib/pgsql/<< major >>/data/postgresql.conf' }}"

<% else %>
      base_extensions: << base_extensions >>
      final_extensions: >-
        {{
          base_extensions
          + (['pg_cron'] if (
              pg_version_to_install | string is version('<< cron_gate >>', '>', strict=True)
            ) else [])
        }}
      pg_conf_path: "{{ '/etc/postgresql/<< major >>/main/postgresql.conf' if ansible_os_family == 'Debian' else '/var/lib/pgsql/<< major >>/data/postgresql.conf' }}"
<% if not legacy_layout | default(false) %>

<% endif %>
<% endif %>
    ansible.builtin.lineinfile:
      path: "{{ pg_conf_path }}"
      regexp: '^#?shared_preload_libraries\s*='
      line: "shared_preload_libraries = '{{ final_extensions | join(', ') }}'"
      state: present
    become: true
<% if oidc | default(false) %>
    # Only run if it's one of your supported families
<% endif %>
    when: ansible_os_family in ["Debian", "RedHat"]

<% if oidc | default(false) %>
  - name: Configure pg_oidc_validator settings in postgresql.conf
    blockinfile:
      path: "{{ '/etc/postgresql/<< major >>/main/postgresql.conf' if ansible_os_family == 'Debian' else '/var/lib/pgsql/<< major >>/data/postgresql.conf' }}"
      marker: "# {mark} ANSIBLE MANAGED BLOCK pg_oidc_validator"
      block: |
        oauth_validator_libraries = 'pg_oidc_validator'
        pg_oidc_validator.authn_field = 'sub'
    when: (ansible_os_family in ["Debian", "RedHat"] and pg_version_to_install | string is version('<< major >>.2', '>=', strict=True))

<% endif %>  - name: Remove pg_hba.conf debian
    file:
      path: /var/lib/pgsql/<< major >>/data/pg_hba.conf
      state: absent
    when: ansible_os_family == "RedHat"

  - name: Remove pg_hba.conf debian
    file:
      path: /etc/postgresql/<< major >>/main/pg_hba.conf
      state: absent
    when: ansible_os_family == "Debian"

  - name: Edit pg_hba.conf RHEL
    blockinfile:
      path: /var/lib/pgsql/<< major >>/data/pg_hba.conf
      create: yes
      owner: postgres
      block: |
        local   all             all                                     trust
        host    all             all             127.0.0.1/32            trust
        host    all             all             ::1/128                 trust
        local   replication     all                                     trust
        host    replication     all             127.0.0.1/32            trust
        host    replication     all             ::1/128                 trust
    when: ansible_os_family == "RedHat"

  - name: Edit pg_hba.conf Debian
    blockinfile:
      create: yes
      owner: postgres
      path: /etc/postgresql/<< major >>/main/pg_hba.conf
      block: |
        local   all             all                                     trust
        host    all             all             127.0.0.1/32            trust
        host    all             all             ::1/128                 trust
        local   replication     all                                     trust
        host    replication     all             127.0.0.1/32            trust
        host    replication     all             ::1/128                 trust
    when: ansible_os_family == "Debian"

<% if oidc | default(false) %>
  - name: Add OIDC entry to pg_hba.conf RHEL
    lineinfile:
      path: /var/lib/pgsql/<< major >>/data/pg_hba.conf
      line: 'host    all             oidc_test_user  127.0.0.1/32            oauth issuer="https://mock-issuer.com", scope="openid"'
      state: present
    when:
      - ansible_os_family == "RedHat"
      - pg_version_to_install | string is version('<< major >>.2', '>=', strict=True)

  - name: Add OIDC entry to pg_hba.conf Debian
    lineinfile:
      path: /etc/postgresql/<< major >>/main/pg_hba.conf
      line: 'host    all             oidc_test_user  127.0.0.1/32            oauth issuer="https://mock-issuer.com", scope="openid"'
      state: present
    when:
      - ansible_os_family == "Debian"
      - pg_version_to_install | string is version('<< major >>.2', '>=', strict=True)

<% endif %>  - name: Restart Postgres RHEL
    include_tasks: "{{ role_path }}/../../tasks/start_postgres_with_diagnostics.yml"
    vars:
      svc_name: postgresql-<< major >>
      svc_state: restarted
    when: ansible_os_family == "RedHat"

  - name: Restart Postgres Debian
    include_tasks: "{{ role_path }}/../../tasks/start_postgres_with_diagnostics.yml"
    vars:
      svc_name: postgresql
      svc_state: restarted
    when: ansible_os_family == "Debian"

  - name: Install etcd packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - etcd
      - percona-haproxy
      - python3-etcd
    when: ansible_os_family == "RedHat"

<% if etcd_restart | default(true) %>
  - name: Restart etcd RHEL
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: etcd
      svc_state: restarted
    when: ansible_os_family == "RedHat"

<% endif %>
<% if legacy_layout | default(false) %>
  - name: Install pgvector packages RHEL
    yum:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-pgvector_<< major >>
      - percona-pgvector_<< major >>-debuginfo
      - percona-pgvector_<< major >>-debugsource
      - percona-pgvector_<< major >>-llvmjit
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< pgvector_gate >>', '>=', strict=True))

  - name: Install pgvector packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
      - percona-postgresql-<< major >>-pgvector
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< pgvector_gate >>', '>=', strict=True))

  - name: Install patroni related packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - etcd
        - percona-haproxy
    when: (ansible_distribution == "Ubuntu") or
      (ansible_os_family == "Debian" and ansible_lsb.major_release|int <= 11) or
      (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< patroni_deb_gate >>', '>=', strict=True))

<% endif %>
  - name: Install patroni related packages Debian
    apt:
      name: "{{ packages }}"
      state: latest
      update_cache: yes
    vars:
      packages:
        - etcd
        - percona-haproxy
    when: ansible_os_family == "Debian"

  - name: Create /etc/patroni directory
    file:
      path: /etc/patroni
      state: directory

  - name: Copy postgresql.yml for patroni service Debian
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql0_deb.yml.j2"
      dest: /etc/patroni/patroni.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Enable and start patroni with wait RHEL
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: patroni
      svc_state: started
      svc_daemon_reload: true
      svc_async: 180
      svc_poll: 5
    when: ansible_os_family == "RedHat"

  # Debian's /etc/patroni/patroni.yml is copied from the same
  # postgresql0_deb.yml template as patroni0's config just below, so both
  # would claim the same etcd member name "postgresql0" if both actually
  # ran -- whichever starts second crashes with "there is already a node
  # named 'postgresql0' running". patroni0/1/2 are the real 3-node cluster;
  # this base unit only needs to exist and be enabled for test_patroni_service,
  # so enable it without starting it on Debian.
  - name: Enable (but do not start) patroni on Debian
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: patroni
      svc_state: stopped
      svc_daemon_reload: true
    when: ansible_os_family == "Debian"

  - name: Create test patroni directory RHEL
    file:
      path: /var/lib/pgsql/patroni_test/
      state: directory
      owner: postgres
      group: postgres
    when: ansible_os_family == "RedHat"

  - name: Create test patroni directory Debian
    file:
      path: /var/lib/postgresql/patroni_test/
      state: directory
      owner: postgres
      group: postgres
    when: ansible_os_family == "Debian"

  - name: Copy postgresql0.yml for patroni service Debian
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql0_deb.yml.j2"
      dest: /var/lib/postgresql/patroni_test/postgresql0.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy postgresql1.yml for patroni service Debian
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql1_deb.yml.j2"
      dest: /var/lib/postgresql/patroni_test/postgresql1.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy postgresql2.yml for patroni service Debian
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql2_deb.yml.j2"
      dest: /var/lib/postgresql/patroni_test/postgresql2.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy postgresql0.yml for patroni service RHEL
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql0.yml.j2"
      dest: /var/lib/pgsql/patroni_test/postgresql0.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Copy postgresql1.yml for patroni service RHEL
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql1.yml.j2"
      dest: /var/lib/pgsql/patroni_test/postgresql1.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Copy postgresql2.yml for patroni service RHEL
    template:
      src: "{{ role_path }}/../../files/patroni_common/postgresql2.yml.j2"
      dest: /var/lib/pgsql/patroni_test/postgresql2.yml
      owner: postgres
      group: postgres
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Copy patroni0 service file Debian
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni0_deb.service"
      dest: /lib/systemd/system/patroni0.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy patroni1 service file Debian
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni1_deb.service"
      dest: /lib/systemd/system/patroni1.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy patroni2 service file Debian
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni2_deb.service"
      dest: /lib/systemd/system/patroni2.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "Debian"

  - name: Copy patroni0 service file RHEL
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni0.service"
      dest: /usr/lib/systemd/system/patroni0.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Copy patroni1 service file RHEL
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni1.service"
      dest: /usr/lib/systemd/system/patroni1.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Copy patroni2 service file RHEL
    copy:
      src: "{{ role_path }}/../../files/patroni_common/patroni2.service"
      dest: /usr/lib/systemd/system/patroni2.service
      owner: root
      group: root
      mode: 0644
    when: ansible_os_family == "RedHat"

  - name: Start etcd
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: etcd
      svc_state: started

  - name: Start patroni0
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: patroni0
      svc_state: started

  - name: Start patroni1
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: patroni1
      svc_state: started

  - name: Start patroni2
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: patroni2
      svc_state: started

  - name: Copy haproxy.cfg
    copy:
      src: "{{ role_path }}/../../files/patroni_common/haproxy.cfg"
      dest: /etc/haproxy/haproxy.cfg
      owner: root
      group: root
      mode: 0644

  - name: Start haproxy
    include_tasks: "{{ role_path }}/../../tasks/start_haproxy_with_diagnostics.yml"
    vars:
      haproxy_cfg: /etc/haproxy/haproxy.cfg

  - name: Wait for the HA cluster to be reachable through haproxy
    include_tasks: "{{ role_path }}/../../tasks/wait_for_haproxy_backend.yml"
    vars:
      haproxy_port: 5000

  - name: Start pgpool service
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: pgpool
      svc_state: started
<% if pgpool_start_gate is defined %>
    when: (ansible_os_family == "RedHat" and pg_version_to_install | string is version('<< pgpool_start_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "RedHat"
<% endif %>

  - name: Start pgpool service
    include_tasks: "{{ role_path }}/../../tasks/start_service_with_diagnostics.yml"
    vars:
      svc_name: percona-pgpool2
      svc_state: started
<% if pgpool_start_gate is defined %>
    when: (ansible_os_family == "Debian" and pg_version_to_install | string is version('<< pgpool_start_gate >>', '>=', strict=True))
<% else %>
    when: ansible_os_family == "Debian"
<% endif %>

  - name: Add user postgres to sudoers
    user:
      name: postgres
      groups: sudo
      append: yes
    when: ansible_os_family == "Debian"

  - name: Pause for 1 minutes
    ansible.builtin.pause:
      minutes: 1
