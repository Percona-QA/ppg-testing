# user@host the worker sshes to, for libvirt and as jump host to the guests.
# Unset means the hypervisor is this machine: bot-setup writes
# <you>@host.docker.internal here, which needs sshd running on this host.
#PPG_HYPERVISOR_SSH=user@hypervisor-host

# private key for that user, on this machine, no passphrase (there is no agent
# in the container). bot-setup creates and authorizes it if missing.
#PPG_SSH_KEY=~/.ssh/ppg-buildbot

# branch the run-* forms preselect. builds clone it from this checkout, so it
# has to be committed, not pushed.
#PPG_TESTING_BRANCH=main

# molecule runs in parallel. sweeps are only safe with 1 for now.
#PPG_LOCAL_SLOTS=4
